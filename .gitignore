# ---- 运行时产物（含真实聊天记录，绝不入库）----
data/
runtime/
*.log

# ---- 环境与密钥 ----
.venv/
venv/
.env

# ---- 界面本地偏好（每人一份，不入库）----
.ui/

# ---- AI 助手的工作记忆（含本机路径，与他人环境无关）----
# 需要长期留存的踩坑记录已整理进 README 与 CHANGELOG。
.workbuddy/

# ---- 一次性安装物（NapCat 压缩包等大文件）----
_install/

# ---- Python 缓存 ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/

# ---- 编辑器：只放行共享的配置 ----
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

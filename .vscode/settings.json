{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.analysis.extraPaths": ["${workspaceFolder}/src"],
  "python.terminal.activateEnvironment": true,
  "files.encoding": "utf8",
  "files.eol": "\r\n",
  "files.associations": {
    "*.cmd": "bat",
    "*.bat": "bat"
  },
  "[python]": {
    "editor.formatOnSave": false,
    "editor.rulers": [100]
  },
  "search.exclude": {
    "**/.venv": true,
    "**/data": true,
    "**/__pycache__": true
  }
}
